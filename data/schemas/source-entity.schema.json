{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://public-works-map.example/schemas/source-entity.schema.json",
  "title": "公式情報源から収集した窓口・連絡先エンティティ（data/source-registry/entities/**/*.json）",
  "description": "公式ページから抽出した office / contact_point のステージング取込元データ。抽出は下書きであり、公開には SCR-07 の二者レビューが必須。個人名・個人メールは含めない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceSlug", "region", "offices"],
  "properties": {
    "sourceSlug": {
      "type": "string",
      "description": "data/source-registry/sources/*.json の id と一致すること"
    },
    "region": {
      "type": "string",
      "enum": ["tokyo", "yokohama", "osaka", "national"]
    },
    "offices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "contacts", "sourceUrl", "confirmedAt"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "roleSummary": { "type": "string" },
          "postalCode": { "type": "string", "pattern": "^\\d{3}-?\\d{4}$" },
          "addressRaw": { "type": "string" },
          "receptionNote": { "type": "string" },
          "contacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contactType", "label", "displayValue"],
              "properties": {
                "contactType": {
                  "type": "string",
                  "enum": ["phone", "web", "email", "counter"]
                },
                "label": { "type": "string", "minLength": 1 },
                "displayValue": { "type": "string", "minLength": 1 },
                "extension": { "type": "string" }
              }
            }
          },
          "sourceUrl": { "type": "string", "pattern": "^https://" },
          "confirmedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
