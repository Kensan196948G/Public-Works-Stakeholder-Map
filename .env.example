# ============================================================
# Public Works Stakeholder Map — 環境変数テンプレート
# 実値は .env（systemd 用）へ。Git へは登録しない。
# ============================================================

# ローカル PostgreSQL 接続文字列（例: postgresql://user:pass@127.0.0.1:5432/pwsm）
# 未設定 = fixture（架空データ）モード。Neon は使用しない
DATABASE_URL=

# データ版識別子（公開データセットのバージョン）
DATASET_VERSION=dev-fixture

# 実行環境: local | preview | staging | production
APP_ENV=local

# Cloudflare Access JWT 検証（Issue #34・既定は無効）
AUTH_ENABLED=false
AUTH_AUDIENCE=
AUTH_JWKS_URL=
# AUTH_CERT_PEM=（秘密情報のため Secret 管理を推奨・複数行 PEM）
AUTH_ADMIN_EMAILS=
AUTH_REVIEWER_EMAILS=
AUTH_EDITOR_EMAILS=
