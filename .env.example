# ============================================================
# Public Works Stakeholder Map — 環境変数テンプレート
# 実値は .env.local / Cloudflare Secrets へ。Git へは登録しない。
# ============================================================

# Neon PostgreSQL 接続文字列（例: postgresql://user:pass@host/db?sslmode=require）
DATABASE_URL=

# データ版識別子（公開データセットのバージョン）
DATASET_VERSION=dev-fixture

# 実行環境: local | preview | staging | production
APP_ENV=local
